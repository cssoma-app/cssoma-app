NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="https://localhost:7057"

# Server-only. Fine-grained PAT, scope Actions:Read-only on cssoma-app/cssoma-app.
# Used by /dashboard/pipeline (CI/CD status page).
GITHUB_TOKEN=""

# Server-only. Render account API key (same key works for every service on the
# account — dev/prod are told apart by service id, not by the key).
# Used by /dashboard/pipeline to show real deploy status (stages 6/8).
RENDER_API_KEY=""

# Sentry DSN — public identifier, safe to embed client-side by design.
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX"

# Server-only. Sentry Auth Token (Settings -> Auth Tokens, scope project:read)
# and org slug. Used by /dashboard/pipeline to show unresolved issue count (stage 9).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
