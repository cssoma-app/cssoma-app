# Backend — variables de entorno para PRODUCCIÓN (Render service conectado a la rama `main`).
#
# .NET no lee archivos .env — esto es solo referencia/checklist. Los valores
# reales van pegados en Render → tu servicio de producción → Environment,
# usando doble guion bajo para anidar (Jwt:Secret -> Jwt__Secret).
#
# IMPORTANTE: nunca reutilices acá los mismos valores que en
# .env.development.example (Jwt__Secret en particular) — deben ser distintos
# entre staging y producción.

ASPNETCORE_ENVIRONMENT=Production

# Cadena de conexión a la base de datos de PRODUCCIÓN en Supabase. Si usás el
# mismo proyecto Supabase para staging y prod, esta es la MISMA cadena que en
# staging; si separaste proyectos Supabase por ambiente, va la de prod.
ConnectionStrings__DefaultConnection=

# Secreto para firmar los JWT propios del backend. Generar uno NUEVO, distinto al de staging:
#   openssl rand -base64 48
Jwt__Secret=
Jwt__Issuer=SSTerraAPI
Jwt__Audience=SSTerraApp

# Origen(es) permitidos por CORS. El dominio real de producción, sin barra final.
AllowedOrigins__0=https://www.ssterraconsultores.com

# Cuenta que se siembra como SuperAdmin la primera vez que arranca la app (ver Backend/Data/DatabaseInitializer.cs).
SuperAdmin__Email=
SuperAdmin__SupabaseAuthId=

# Resend (envío de emails transaccionales: código OTP, bienvenida).
Resend__ApiKey=
Resend__FromEmail=info@ssterraconsultores.com
Resend__FromName=SSTerra Consultores

# Sentry (monitoreo de errores). DSN público, mismo proyecto que staging — el
# ambiente se etiqueta solo vía ASPNETCORE_ENVIRONMENT. Vacío = Sentry no hace nada.
Sentry__Dsn=
