# Backend — variables de entorno para STAGING (Render service conectado a la rama `develop`).
#
# .NET no lee archivos .env — esto es solo referencia/checklist. Los valores
# reales van pegados en Render → tu servicio de staging → Environment,
# usando doble guion bajo para anidar (Jwt:Secret -> Jwt__Secret).
# Para desarrollo LOCAL en tu máquina, no uses este archivo: usa
# `dotnet user-secrets set "Clave:Subclave" "valor" --project Backend/BackendAPI.csproj`.

ASPNETCORE_ENVIRONMENT=Development

# Cadena de conexión a la base de datos de STAGING en Supabase (Settings -> Database -> Connection string -> URI, modo "Session pooler" o "Transaction pooler" segun corresponda).
ConnectionStrings__DefaultConnection=

# Secreto para firmar los JWT propios del backend. Generar uno distinto al de producción:
#   openssl rand -base64 48
Jwt__Secret=
Jwt__Issuer=SSTerraAPI
Jwt__Audience=SSTerraApp

# Origen(es) permitidos por CORS. El/los dominio(s) del frontend de staging (Vercel Preview / rama develop).
AllowedOrigins__0=

# Cuenta que se siembra como SuperAdmin la primera vez que arranca la app (ver Backend/Data/DatabaseInitializer.cs).
SuperAdmin__Email=
SuperAdmin__SupabaseAuthId=

# Resend (envío de emails transaccionales: código OTP, bienvenida).
Resend__ApiKey=
Resend__FromEmail=info@ssterraconsultores.com
Resend__FromName=SSTerra Consultores

# Sentry (monitoreo de errores). DSN público, mismo proyecto que prod — el
# ambiente se etiqueta solo vía ASPNETCORE_ENVIRONMENT. Vacío = Sentry no hace nada.
Sentry__Dsn=
