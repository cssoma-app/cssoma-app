{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [ "http://localhost:3000" ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=sst_saas;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "superSecretKeyCSOMA2026SSTerraSaaSPlatform",
    "Issuer": "SSTerraAPI",
    "Audience": "SSTerraApp"
  },
  "SuperAdmin": {
    "Email": "barujaba@gmail.com",
    "SupabaseAuthId": "superadmin-auth-id-from-supabase"
  },
  "Resend": {
    "ApiKey": "",
